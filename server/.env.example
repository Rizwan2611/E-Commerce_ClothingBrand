# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/mens_clothing_store

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Admin JWT (separate secret for shopkeepers)
ADMIN_JWT_SECRET=your_super_secret_admin_jwt_key_change_in_production
ADMIN_JWT_EXPIRES_IN=1d

# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-bucket-name

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
SHOPKEEPER_WHATSAPP_NUMBER=whatsapp:+1234567890

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Shop Location (for map embed)
SHOP_LAT=40.7128
SHOP_LNG=-74.0060
